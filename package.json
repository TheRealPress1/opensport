{
  "name": "opensport",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predev": "node scripts/prepare-release.mjs",
    "prebuild": "node scripts/prepare-release.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test && npm run test:ops && npm run test:desktop && npm run build && npm run test:e2e",
    "release:prepare": "npm run check",
    "test:db": "bash supabase/tests/run.sh",
    "test:ops": "node --test scripts/ops.test.mjs",
    "test:edge": "deno test --allow-env supabase/tests/handler.test.ts",
    "test:live": "playwright test --config tests/browser-live/playwright.config.js",
    "desktop:prepare": "node scripts/build-desktop.mjs",
    "desktop:dev": "electron desktop/main.mjs",
    "desktop:build": "node scripts/build-desktop.mjs --bundle",
    "test:desktop": "node --test desktop/tests/*.test.mjs",
    "test:desktop:ui": "playwright test --config tests/browser-desktop/playwright.config.js",
    "test:desktop:electron": "OPENSPORT_ELECTRON_TEST=1 node --test desktop/tests/electron.integration.mjs",
    "test:desktop:native": "node desktop/tests/native.integration.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "http-proxy": "1.18.1",
    "pg": "8.23.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "44.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fflate": "0.8.3",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.4"
  },
  "license": "MIT",
  "description": "Open-source team coordination. Your team. Your community. OpenSport.",
  "engines": {
    "node": ">=22.12.0"
  }
}
