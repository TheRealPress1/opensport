# project = public website and isolated demo; team = your own team instance.
VITE_APP_MODE=project
# Only public API credentials belong in VITE_ variables. Never use service keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional. Manual location input works without Google Maps.
VITE_GOOGLE_MAPS_API_KEY=
